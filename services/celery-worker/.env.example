# Celery Worker — Environment Variables
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_PUBSUB_URL=redis://localhost:6379/0

DATABASE_URL=postgresql+psycopg2://iot_user:iot_pass@localhost:5432/iot_platform

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=celery-worker

LOG_LEVEL=INFO
