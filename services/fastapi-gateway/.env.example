# FastAPI Gateway — Environment Variables
# Copy to .env and fill in actual values

# App
APP_ENV=development
LOG_LEVEL=INFO

# JWT (HS256)
JWT_SECRET_KEY=change_me_super_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Bootstrap admin account (used by Flask Admin login against /auth/token)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password
ADMIN_EMAIL=admin@iot.local

# Database
# Dev: SQLite (auto-created as iot_platform.db)
# Prod: set to postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./iot_platform.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# MQTT (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=fastapi-gateway
